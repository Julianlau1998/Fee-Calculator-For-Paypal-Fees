    "Rate for direct goods & services payments. PayPal Checkout in online shops costs 2.99 % + 0.39 €." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gebührensatz für direkte Zahlungen für Waren und Dienstleistungen. PayPal Checkout in Onlineshops kostet 2,99 % + 0,39 €."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tarifa para pagos directos por bienes y servicios. PayPal Checkout en tiendas online cuesta 2,99 % + 0,39 €."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Taux pour les paiements directs de biens et services. PayPal Checkout sur les boutiques en ligne coûte 2,99 % + 0,39 €."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tariffa per pagamenti diretti per beni e servizi. PayPal Checkout nei negozi online costa 2,99% + 0,39 €."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sats for direkte betalinger for varer og tjenester. PayPal Checkout i nettbutikker koster 2,99 % + 0,39 €."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Avgift för direkta betalningar för varor och tjänster. PayPal Checkout i webbutiker kostar 2,99 % + 0,39 €."
          }
        }
      }
    },
    "Rate for goods & services payments between PayPal accounts. PayPal Checkout costs 3.49 % + $0.49." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
