    "See what arrives after fees – or how much to request so the fees are covered." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sieh, was nach Abzug der Gebühren ankommt – oder wie viel du anfordern musst, damit die Gebühren gedeckt sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Descubre lo que llega tras descontar las tarifas o cuánto debes solicitar para cubrirlas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Découvrez le montant reçu après déduction des frais, ou combien demander pour les couvrir."
