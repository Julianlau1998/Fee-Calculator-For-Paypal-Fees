    "This app is not affiliated with PayPal. The rates were carefully researched from PayPal's published fee schedules, but no guarantee can be given that they are correct and up to date." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Diese App steht in keiner Verbindung zu PayPal. Die Gebührensätze wurden sorgfältig anhand der veröffentlichten Gebührenübersichten von PayPal recherchiert, es kann jedoch keine Gewähr für ihre Richtigkeit und Aktualität übernommen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Esta app no está afiliada a PayPal. Las tarifas se han investigado cuidadosamente a partir de las tablas de tarifas publicadas por PayPal, pero no se puede garantizar que sean correctas y estén actualizadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cette app n’est pas affiliée à PayPal. Les taux ont été soigneusement établis à partir des grilles tarifaires publiées par PayPal, mais leur exactitude et leur actualité ne peuvent être garanties."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Questa app non è affiliata a PayPal. Le tariffe sono state verificate con cura sui tariffari pubblicati da PayPal, ma non è possibile garantire che siano corrette e aggiornate."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Appen er ikke tilknyttet PayPal. Satsene er nøye kontrollert mot PayPals publiserte avgiftsoversikter, men det kan ikke garanteres at de er riktige og oppdaterte."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Den här appen är inte anknuten till PayPal. Avgifterna har noggrant tagits fram utifrån PayPals publicerade avgiftsöversikter, men det finns ingen garanti för att de är korrekta och aktuella."
          }
        }
      }
    },
    "This app shows ads from Google AdMob. Ad requests never contain the amounts you enter." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Diese App zeigt Werbung von Google AdMob. Werbeanfragen enthalten nie die Beträge, die du eingibst."
