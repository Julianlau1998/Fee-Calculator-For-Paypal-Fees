    "Enter how much should arrive. You'll see how much to request so the fees are covered." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gib ein, wie viel ankommen soll. Du siehst, wie viel du anfordern musst, damit die Gebühren gedeckt sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Introduce cuánto debe llegar. Verás cuánto tienes que solicitar para cubrir las tarifas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Saisissez le montant à recevoir. Vous verrez combien demander pour couvrir les frais."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Inserisci quanto deve arrivare. Vedrai quanto richiedere per coprire le tariffe."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Skriv inn hvor mye som skal komme frem. Du ser hvor mye du må be om for å dekke avgiftene."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ange hur mycket som ska komma fram. Du ser hur mycket du ska begära för att täcka avgifterna."
          }
        }
      }
    },
    "Enter the amount that is sent. You'll see the fees and how much arrives." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gib den gesendeten Betrag ein. Du siehst die Gebühren und wie viel ankommt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Introduce el importe enviado. Verás las tarifas y cuánto llega."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Saisissez le montant envoyé. Vous verrez les frais et le montant reçu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Inserisci l’importo inviato. Vedrai le tariffe e quanto arriva."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Skriv inn beløpet som sendes. Du ser avgiftene og hvor mye som kommer frem."
          }
        },
        "sv" : {
