    "Calculate without banners and full-screen ads – also no more consent prompts." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Rechne ohne Banner und Vollbildwerbung – und ohne Einwilligungsabfragen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Calcula sin banners ni anuncios a pantalla completa, y sin más solicitudes de consentimiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Calculez sans bannières ni publicités plein écran, et sans demandes de consentement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Calcola senza banner né pubblicità a schermo intero, e senza più richieste di consenso."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Beregn uten bannere og fullskjermannonser – og slipp spørsmål om samtykke."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Räkna utan banners och helskärmsannonser – och slipp frågor om samtycke."
          }
        }
      }
    },
    "Calculate without distractions and get more out of every sale." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Rechne ohne Ablenkung und hol mehr aus jedem Verkauf heraus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Calcula sin distracciones y saca más partido a cada venta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Calculez sans distractions et tirez le meilleur parti de chaque vente."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Calcola senza distrazioni e ottieni di più da ogni vendita."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Beregn uten forstyrrelser, og få mer ut av hvert salg."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Räkna utan distraktioner och få ut mer av varje försäljning."
          }
        }
      }
    },
