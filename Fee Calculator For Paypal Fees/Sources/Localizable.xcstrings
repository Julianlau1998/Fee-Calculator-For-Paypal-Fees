    "The fee is higher than the amount. Nothing would arrive." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Gebühr ist höher als der Betrag. Es würde nichts ankommen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La tarifa es superior al importe. No llegaría nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Les frais dépassent le montant. Vous ne recevriez rien."
