    "Tap a calculation to open it in the calculator with the current fee profile." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tippe auf eine Berechnung, um sie mit dem aktuellen Gebührenprofil im Rechner zu öffnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Toca un cálculo para abrirlo en la calculadora con el perfil de tarifas actual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Touchez un calcul pour l’ouvrir dans le calculateur avec le profil de frais actuel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tocca un calcolo per aprirlo nel calcolatore con il profilo tariffe attuale."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Trykk på en beregning for å åpne den i kalkulatoren med gjeldende avgiftsprofil."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tryck på en beräkning för att öppna den i räknaren med den aktuella avgiftsprofilen."
          }
        }
      }
    },
    "Tap an amount to open it in the calculator. Sender location and currency conversion from the calculator are taken into account." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tippe auf einen Betrag, um ihn im Rechner zu öffnen. Herkunft der Zahlung und Währungsumrechnung aus dem Rechner werden berücksichtigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Toca un importe para abrirlo en la calculadora. Se tienen en cuenta el origen del pago y la conversión de divisas de la calculadora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Touchez un montant pour l’ouvrir dans le calculateur. La provenance du paiement et la conversion de devises définies dans le calculateur sont prises en compte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tocca un importo per aprirlo nel calcolatore. Vengono considerate la provenienza del pagamento e la conversione di valuta impostate nel calcolatore."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Trykk på et beløp for å åpne det i kalkulatoren. Avsenders plassering og valutaomregning fra kalkulatoren tas med i beregningen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tryck på ett belopp för att öppna det i räknaren. Avsändarens plats och valutaväxling från räknaren tas med i beräkningen."
          }
        }
      }
    },
    "Tap the bookmark in the calculator to save a calculation here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tippe im Rechner auf das Lesezeichen, um hier eine Berechnung zu sichern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Toca el marcador en la calculadora para guardar aquí un cálculo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Touchez le signet dans le calculateur pour enregistrer un calcul ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tocca il segnalibro nel calcolatore per salvare qui un calcolo."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Trykk på bokmerket i kalkulatoren for å lagre en beregning her."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tryck på bokmärket i räknaren för att spara en beräkning här."
          }
        }
      }
    },
