    "PayPal fees differ from country to country. Choose your PayPal market once and the calculator uses the right rates." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "PayPal-Gebühren unterscheiden sich von Land zu Land. Wähle einmal deinen PayPal-Markt aus und der Rechner verwendet die richtigen Gebührensätze."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Las tarifas de PayPal varían según el país. Elige una vez tu mercado de PayPal y la calculadora usará las tarifas correctas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Les frais PayPal varient d’un pays à l’autre. Choisissez une fois votre marché PayPal, et le calculateur appliquera les bons taux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le tariffe PayPal variano da Paese a Paese. Scegli una volta il tuo mercato PayPal e il calcolatore userà le tariffe corrette."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "PayPal-avgiftene varierer fra land til land. Velg PayPal-marked én gang, så bruker kalkulatoren riktige satser."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "PayPal-avgifterna varierar från land till land. Välj din PayPal-marknad en gång så använder räknaren rätt avgifter."
          }
        }
      }
    },
    "PayPal India only supports international payments. The fixed fee depends on the received currency." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "PayPal Indien unterstützt nur internationale Zahlungen. Die feste Gebühr hängt von der empfangenen Währung ab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "PayPal India solo admite pagos internacionales. La tarifa fija depende de la divisa recibida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "PayPal Inde ne prend en charge que les paiements internationaux. Les frais fixes dépendent de la devise reçue."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "PayPal India supporta solo pagamenti internazionali. La tariffa fissa dipende dalla valuta ricevuta."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "PayPal India støtter kun internasjonale betalinger. Den faste avgiften avhenger av valutaen som mottas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "PayPal Indien stöder endast internationella betalningar. Den fasta avgiften beror på vilken valuta som tas emot."
          }
        }
      }
    },
